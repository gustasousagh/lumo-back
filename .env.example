# =============================================================================
# Lumo API — variáveis de ambiente
# Copie para .env (ou cole no painel de deploy). NUNCA commite o .env real.
# =============================================================================

# --- Banco de dados (MySQL) --------------------------------------------------
# Host interno do serviço de banco. Só resolve de dentro da mesma rede/projeto;
# de fora, use o host/porta público que o painel expõe.
DB_HOST=bancos-de-dados-mysql-0uyrix
DB_PORT=3306
DB_NAME=lumo
DB_USERNAME=root
DB_PASSWORD=troque-aqui

# Alternativa: define a JDBC URL inteira e ignora DB_HOST/DB_PORT/DB_NAME.
# Se usar, mantenha createDatabaseIfNotExist=true — sem ele, um MySQL zerado
# derruba a aplicação com "Unknown database" (erro 1049).
# DB_URL=jdbc:mysql://bancos-de-dados-mysql-0uyrix:3306/lumo?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8

# Tamanho do pool de conexões (Hikari).
DB_POOL_SIZE=10

# 'update' deixa o Hibernate criar/ajustar as tabelas. Depois que o schema
# estabilizar, troque para 'validate'.
JPA_DDL_AUTO=update

# --- Autenticação ------------------------------------------------------------
# Chave de assinatura do JWT. Mínimo 32 caracteres, aleatória.
# Gere com:  openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-aleatoria-de-no-minimo-32-caracteres

# --- Email (confirmação de conta / reset de senha) ---------------------------
# Gmail: senha de app em https://myaccount.google.com/apppasswords (2FA ligado).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=sua-senha-de-app-de-16-digitos
# Opcional: remetente exibido. O endereço precisa ser o mesmo do MAIL_USERNAME.
# MAIL_FROM=Lumo 🎬 <seu-email@gmail.com>

# --- Catálogo de mídia (GoCine) ---------------------------------------------
# A API é quem fala com o GoCine (antes era o servidor do Next). Sem estas duas,
# /api/media/* responde 500.
GOCINE_API_URL=https://siteapi.gocine.app/api
GOCINE_JWT_SECRET=cole-aqui-o-token-do-gocine
# Cache em memória das respostas, substituindo o revalidate que o Next fazia.
GOCINE_CACHE_MINUTES=5
GOCINE_CACHE_MAX_ENTRIES=500

# --- Front ------------------------------------------------------------------
# URL do frontend: usada nos links dos emails e na liberação de CORS.
FRONTEND_URL=http://localhost:3000
